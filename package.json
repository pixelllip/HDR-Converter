{
  "name": "hdr-converter-electron",
  "version": "1.0.0",
  "description": "Electron 版 HDR 转换器，支持 HDR PNG / Ultra HDR JPEG",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.hdr-converter.electron",
    "productName": "HDR Converter",
    "directories": {
      "output": "dist"
    },
    "icon": "assets/logo.ico",
    "files": [
      "main.js",
      "preload.js",
      "video_converter.js",
      "mp4_hdr.js",
      "st2094_50.js",
      "st2094_50_inject.js",
      "hevc_inject.js",
      "views/**/*",
      "assets/**/*",
      "backend/cuda/**/*",
      "backend/ffmpeg/**/*",
      "backend/kotlin/build/libs/*.jar",
      "extracted_hdr_core/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "assets/**/*",
      "backend/ffmpeg/**/*",
      "backend/cuda/**/*",
      "backend/kotlin/build/libs/*.jar"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "HDR-Converter-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "sharp": "^0.35.3"
  }
}