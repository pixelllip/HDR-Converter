{
  "name": "hdr-converter-electron",
  "version": "0.4.2",
  "description": "简易 Electron HDR 转换器",
  "main": "main.js",
  "author": {
    "name": "pixelllip",
    "url": "https://github.com/pixelllip"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/pixelllip/HDR-Converter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixelllip/HDR-Converter.git"
  },
  "bugs": {
    "url": "https://github.com/pixelllip/HDR-Converter/issues"
  },
  "scripts": {
    "start": "electron .",
    "typecheck": "node tests/check_types.js",
    "build": "electron-builder",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "com.hdr-converter.electron",
    "productName": "HDR Converter",
    "copyright": "Copyright © 2026 pixelllip",
    "directories": {
      "output": "dist"
    },
    "icon": "assets/logo.ico",
    "files": [
      "main.js",
      "preload.js",
      "system_theme.js",
      "video_converter.js",
      "mp4_hdr.js",
      "st2094_50.js",
      "st2094_50_inject.js",
      "hevc_inject.js",
      "views/**/*",
      "assets/**/*",
      "backend/cuda/**/*",
      "backend/ffmpeg/**/*",
      "backend/rust/target/release/hdrconv.exe",
      "package.json"
    ],
    "extraFiles": [
      "LICENSE",
      "NOTICE"
    ],
    "asarUnpack": [
      "assets/**/*",
      "backend/ffmpeg/**/*",
      "backend/cuda/**/*",
      "backend/rust/target/release/hdrconv.exe"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "HDR-Converter-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@types/node": "^24.9.0",
    "electron": "^44.9.3",
    "electron-builder": "^26.18.0",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2"
  }
}
